# Kernel src/ line coverage floor (domain + runtime + lib.rs).
# src/testing/ is the test-util harness and does not count.
# Do not lower floor_lines_pct without an ADR.
#
# Measured after 100% kernel line gate: every lcov DA executable line in
# src/domain, src/runtime, and src/lib.rs is hit by the default suite
# (lib + adversarial/catalog/consumer/graph/resilience/scenarios/stress/
# stress_uneven/structure/workloads; not stress_100k). Hits are OR-merged
# across cargo test CGUs (lib tests vs integration tests). Native
# `cargo llvm-cov report` can show a slightly lower % (closing-brace
# regions / per-CGU AND); the python gate is the 100% check.
# Branch (lcov BRF) is 0 with this llvm-cov/llvm-tools pair — not gated.

floor_lines_pct=100
fail_under_lines=100

# Empty: a leftover kernel line is a CI failure. src/testing/ is excluded
# from the kernel percentage and must not be listed here.

allow:
